# Current LLM runtime
LLM_PROVIDER=openrouter
LLM_MAX_TOKENS=16000
DEV_FILE_BATCH_SIZE=3

# OpenRouter provider
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_MAX_TOKENS=16000

# OpenAI/Codex provider
# To use an OpenAI API key temporarily, set LLM_PROVIDER=openai and fill these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=16000

# Local safety defaults
ENABLE_DASHBOARD=false
RUN_RATE_LIMIT_MAX=10
RUN_RATE_LIMIT_WINDOW_MS=600000
MAX_REQUIREMENT_IMAGES=8
MAX_REQUIREMENT_IMAGE_BYTES=5242880
MAX_PRODUCT_ASSETS=30
MAX_PRODUCT_ASSET_BYTES=2097152
MAX_PRODUCT_ASSET_TOTAL_BYTES=20971520
# Automatic asset download uses Openverse openly licensed image search when enabled per run.
ENABLE_AUTO_PRODUCT_ASSET_DOWNLOAD=true
ENABLE_STANDARD_GUARD_MODE=true
VALIDATE_GENERATED_EXECUTION=true
ALLOW_GENERATED_DOCKER=true
REQUIRE_DEPLOYED_CONTAINERS=true
GENERATED_FRONTEND_PORT=3000
GENERATED_BACKEND_PORT=8000
# Use auto, docker, or nerdctl. Rancher Desktop supports docker compose in Docker-compatible mode and nerdctl compose in containerd mode.
GENERATED_COMPOSE_ENGINE=auto
# In production, set RUN_API_TOKEN or explicitly set ALLOW_UNAUTHENTICATED_RUNS=true.
RUN_API_TOKEN=
ALLOW_UNAUTHENTICATED_RUNS=false

OPENROUTER_APP_NAME=Agentic Sprint Builder
OPENROUTER_SITE_URL=http://localhost:3000

# Contest dashboard
DASHBOARD_BASE_URL=https://aitechcontest.kms-technology.com/api
DASHBOARD_COMPANY_ID=
DASHBOARD_COMPANY_NAME=Agentic Sprint Builder
